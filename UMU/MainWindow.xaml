<Window x:Class="UMU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UMU"
        mc:Ignorable="d"
        Title="MainWindow" Height="629" Width="926" KeyDown="Window_KeyDown" ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="1"/>
                <GradientStop Color="White" Offset="0.091"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFDADADA" Height="471" Width="422" Margin="30,115,0,0">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Label Content="Текущая статистика" HorizontalAlignment="Center" VerticalAlignment="Top" Height="32" Width="159" Margin="0,15,0,0" FontWeight="Bold" FontFamily="Times New Roman" FontSize="16"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="689,115,0,0" HorizontalAlignment="Left" Width="211" Height="109" VerticalAlignment="Top">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="White" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Приход" HorizontalAlignment="Center" VerticalAlignment="Center" Height="103" Width="216" Background="#FFDADADA" Click="Button_Click" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"/>
        </Border>
        <ListBox x:Name="cart_list" d:ItemsSource="{d:SampleData ItemCount=6}" Margin="44,170,0,0" BorderBrush="#FF424646" VerticalContentAlignment="Center" Background="#FFDADADA" HorizontalAlignment="Left" Width="397" Height="405" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="377">
                        <Label Content="{Binding Path=id}" HorizontalAlignment="Left" Width="50" Height="26" VerticalAlignment="Center" Padding="5"/>
                        <Label Content="{Binding Path=name}" Margin="50,0,0,0" HorizontalAlignment="Left" Width="258" Height="26" VerticalAlignment="Center"></Label>
                        <Label Content="{Binding Path=value}" Margin="308,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border BorderBrush="Black" CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="0,30,0,0" Height="68" VerticalAlignment="Top" HorizontalAlignment="Center" Width="416" Background="#FFDADADA">
            <Label Content="Система Учёта Картриджей (СУК)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="48" Width="396" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="689,477,0,0" Height="109" VerticalAlignment="Top" HorizontalAlignment="Left" Width="211">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Уход" HorizontalAlignment="Center" VerticalAlignment="Center" Height="103" Width="216" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_1"/>
        </Border>
        <Border BorderBrush="Black" CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="10,13,0,0" HorizontalAlignment="Left" Width="92" Height="37" VerticalAlignment="Top">
            <Button Content="Сервер" HorizontalAlignment="Center" VerticalAlignment="Center" Height="37" Width="92" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_2"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="496,531,0,0" HorizontalAlignment="Left" Width="108" Height="55" VerticalAlignment="Top">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Обновить" HorizontalAlignment="Center" VerticalAlignment="Center" Height="49" Width="102" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_3"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="496,468,0,0" HorizontalAlignment="Left" Width="108" Height="55" VerticalAlignment="Top">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Отчет" HorizontalAlignment="Center" VerticalAlignment="Center" Height="49" Width="102" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_4"/>
        </Border>

    </Grid>
</Window>
