<Window x:Class="UMU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UMU"
        mc:Ignorable="d"
        Title="Система учета картриджей" MinHeight="629" Height="629" Width="940" MinWidth="926" KeyDown="Window_KeyDown" ResizeMode="NoResize">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="615">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="1"/>
                <GradientStop Color="White" Offset="0.091"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFDADADA" Height="471" Width="646" Margin="10,115,0,0">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="Black" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Label Content="Текущая статистика" HorizontalAlignment="Center" VerticalAlignment="Top" Height="32" Width="159" Margin="0,15,0,0" FontWeight="Bold" FontFamily="Times New Roman" FontSize="16"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="689,115,0,0" HorizontalAlignment="Left" Width="222" Height="109" VerticalAlignment="Top">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="White" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Приход" HorizontalAlignment="Center" VerticalAlignment="Center" Height="103" Width="216" Background="#FFDADADA" Click="Button_Click" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"/>
        </Border>
        <ListBox x:Name="cart_list" Margin="21,170,0,0" BorderBrush="#FF424646" VerticalContentAlignment="Center" Background="#FFDADADA" HorizontalAlignment="Left" Width="621" Height="405" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="605">
                        <Label Content="{Binding id}" HorizontalAlignment="Left" Width="50" Height="26" VerticalAlignment="Center" Padding="5"/>
                        <Label Content="{Binding name}" Margin="50,0,0,0" HorizontalAlignment="Left" Width="435" Height="26" VerticalAlignment="Center"/>
                        <Label Content="{Binding value}" Margin="500,0,0,0" HorizontalAlignment="Right" Width="103"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border BorderBrush="Black" CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="0,28,0,0" Height="70" VerticalAlignment="Top" HorizontalAlignment="Center" Width="896" Background="#FFDADADA">
            <Label Content="Система Учёта Картриджей (СУК)" HorizontalAlignment="Center" VerticalAlignment="Top" Height="48" Width="388" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" Margin="0,16,0,0"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="689,296,0,0" Height="113" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Уход (Врачам)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="103" Width="216" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_1"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="549,132,0,0" HorizontalAlignment="Left" Width="93" Height="33" VerticalAlignment="Top" BorderBrush="Black">
            <Button Content="Обновить" HorizontalAlignment="Center" VerticalAlignment="Center" Height="34" Width="92" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_3"/>
        </Border>
        <Border CornerRadius="6,6,6,6" Padding="2" BorderThickness="2" Margin="689,478,0,0" Height="108" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Button Content="Уход (В коробку)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="103" Width="216" Background="#FFDADADA" FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Click="Button_Click_5"/>
        </Border>
        <Menu Height="25" VerticalAlignment="Top"  HorizontalContentAlignment="Stretch" Background="#FFE4E4E4" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Stretch">
            <MenuItem Header="Модули" Width="69" Height="22"  Background="{x:Null}" BorderBrush="Black">
                <MenuItem Header="Картриджи" Click="Button_Click_6"></MenuItem>
                <MenuItem Header="Выгрузка" Click="Button_Click_4"></MenuItem>
                <MenuItem Header="Аналитика" Click="Button_Click_7"></MenuItem>
                <MenuItem Header="Потребность" Click="Open_Requirement"></MenuItem>
            </MenuItem>
            <MenuItem Header="Настройки" Width="88" Height="22" BorderBrush="Black" Margin="1,1,0,0" Click="Button_Click_2">
            </MenuItem>
        </Menu>
    </Grid>
</Window>
