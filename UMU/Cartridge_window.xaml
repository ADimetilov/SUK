<Window x:Class="UMU.Cartridge"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UMU"
        mc:Ignorable="d"
        Title="Картриджи" Height="574" Width="1072" FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="0,0,0,-6" Background="#FFFFCACA">
        <Label Content="Картриджи" HorizontalAlignment="Left" Margin="103,0,0,508" VerticalAlignment="Bottom" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold"/>
        <Button x:Name="Delete_button" Content="Удалить" HorizontalAlignment="Left" Margin="40,0,0,109" VerticalAlignment="Bottom" Height="26" Width="70" Click="Delete_button_Click" Background="Red" FontWeight="Bold"/>
        <ListBox x:Name="cart_list" d:ItemsSource="{d:SampleData ItemCount=6}" Margin="40,0,0,155" BorderBrush="#FF424646" VerticalContentAlignment="Center" Background="White" HorizontalAlignment="Left" Width="261" Height="348" VerticalAlignment="Bottom" SelectionChanged="cart_list_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Label Content="{Binding id}" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center" Padding="5"/>
                        <Label Content="{Binding name}" Margin="50,0,0,0" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="Add_button" Content="Добавить" HorizontalAlignment="Left" Margin="231,0,0,109" VerticalAlignment="Bottom" Height="26" Width="70" Click="Add_button_Click" Background="#FF71EA11" FontWeight="Bold"/>
        <TextBox x:Name="NameAdd_Box" HorizontalAlignment="Left" Margin="40,0,0,61" TextWrapping="Wrap" VerticalAlignment="Bottom" Width="261" Height="26" FontSize="16" FontFamily="Times New Roman"/>
        <Button Content="Изменить" HorizontalAlignment="Left" Margin="122,0,0,109" VerticalAlignment="Bottom" Height="26" Width="96" Click="Button_Click" Background="#FF41BED6" FontWeight="Bold"/>
        <Label HorizontalAlignment="Left" Margin="748,23,0,0" VerticalAlignment="Top" FontFamily="Times New Roman" FontSize="24"/>
        <Button x:Name="delete_model" Content="Удалить" HorizontalAlignment="Left" Margin="748,0,0,109" VerticalAlignment="Bottom" Height="26" Width="70" Click="delete_model_Click" Background="Red" FontWeight="Bold"/>
        <ListBox x:Name="Model_list" d:ItemsSource="{d:SampleData ItemCount=6}" Margin="748,0,0,155" BorderBrush="#FF424646" VerticalContentAlignment="Center" Background="White" HorizontalAlignment="Left" Width="261" Height="348" VerticalAlignment="Bottom" SelectionChanged="Model_list_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Label Content="{Binding id}" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center" Padding="5"/>
                        <Label Content="{Binding name}" Margin="50,0,0,0" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="add_model" Content="Добавить" HorizontalAlignment="Left" Margin="939,0,0,109" VerticalAlignment="Bottom" Height="26" Width="70" Click="add_model_Click" Background="#FF71EA11" FontWeight="Bold"/>
        <TextBox x:Name="NameAdd_model_box" HorizontalAlignment="Left" Margin="748,0,0,61" TextWrapping="Wrap" VerticalAlignment="Bottom" Width="261" Height="26" FontSize="16" FontFamily="Times New Roman"/>
        <Button x:Name="edit_model" Content="Изменить" HorizontalAlignment="Left" Margin="830,0,0,109" VerticalAlignment="Bottom" Height="26" Width="96" Click="edit_model_Click" Background="#FF41BED6" FontWeight="Bold"/>
        <ListBox x:Name="LinkListCart" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="389,0,0,302" Height="174" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="269" BorderBrush="Black">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="251">
                        <Label Content="{Binding id}" HorizontalAlignment="Left" Width="50" Height="26" VerticalAlignment="Center" Padding="5" Visibility="Hidden"/>
                        <Label Content="{Binding name}" Margin="0,0,0,0" HorizontalAlignment="Left" Width="201" Height="26" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="LinkCartAdd" Content="&gt;&gt;" HorizontalAlignment="Left" Margin="326,0,0,389" VerticalAlignment="Bottom" Height="44" Width="41" Click="LinkCartAdd_Click" Background="#FF71EA11" FontWeight="Bold"/>
        <Button x:Name="LinkCartDel" Content="&lt;&lt;" HorizontalAlignment="Left" Margin="326,0,0,329" VerticalAlignment="Bottom" Height="44" Width="41" Click="LinkCartDel_Click" Background="Red" FontWeight="Bold"/>
        <Button x:Name="LinkModelAdd" Content="&lt;&lt;" HorizontalAlignment="Left" Margin="681,0,0,238" VerticalAlignment="Bottom" Height="44" Width="40" Click="LinkModelAdd_Click" Background="#FF71EA11" FontWeight="Bold"/>
        <Button x:Name="LinkModelDel" Content="&gt;&gt;" HorizontalAlignment="Left" Margin="681,0,0,174" VerticalAlignment="Bottom" Height="44" Width="41" Click="LinkModelDel_Click" Background="Red" FontWeight="Bold"/>
        <Label Content="Модели" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontFamily="Times New Roman" FontSize="24" Margin="833,0,0,508" Height="38" Width="93" FontWeight="Bold"/>
        <Label Content="Связь" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontFamily="Times New Roman" FontSize="24" Margin="486,0,0,481" Height="38" Width="74" FontWeight="Bold"/>
        <ListBox x:Name="LinkListModel" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="390,0,0,141" Height="155" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="268" BorderBrush="Black">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="251">
                        <Label Content="{Binding model_id}" HorizontalAlignment="Left" Width="50" Height="26" VerticalAlignment="Center" Padding="5" Visibility="Hidden"/>
                        <Label Content="{Binding name}" Margin="0,0,0,0" HorizontalAlignment="Left" Width="170" Height="26" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="SubmitChangeButton" Content="Сохранить" HorizontalAlignment="Left" Margin="474,0,0,76" VerticalAlignment="Bottom" Height="32" Width="98" Click="SubmitChangeButton_Click" Background="#FF41BED6" FontWeight="Bold"/>
    </Grid>
</Window>
